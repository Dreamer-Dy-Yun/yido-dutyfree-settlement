# Nginx 설정을 위한 환경 변수 예제 파일
# 이 파일을 복사하여 nginx.env 파일을 만들고 실제 값으로 수정하세요
# cp nginx.env.example nginx.env

# Nginx 포트 (기본값: 80)
NGINX_LISTEN_PORT=80

# 메인 도메인 (실제 서비스)
NGINX_MAIN_DOMAIN=yourdomain.com

# 관리자 페이지 도메인
NGINX_ADMIN_DOMAIN=admin.yourdomain.com

# 메인 프론트엔드 빌드 파일 경로
NGINX_MAIN_FRONTEND_PATH=/var/www/production-frontend/dist

# 관리자 페이지 빌드 파일 경로
NGINX_ADMIN_FRONTEND_PATH=/var/www/TEMPLATE.WEB/admin-frontend/dist

# FastAPI 백엔드 (호스트에서 직접 Nginx 쓸 때는 127.0.0.1, Docker Nginx는 host.docker.internal)
FASTAPI_PROXY_HOST=127.0.0.1
FASTAPI_PORT=10000

# Nginx 설정 파일 이름 (자동 적용 시 사용)
NGINX_PROJECT_NAME=your-project
