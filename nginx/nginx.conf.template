# Nginx 설정 템플릿 파일
# 환경 변수를 사용하여 동적으로 설정 생성
# 사용법: python deploy_nginx.py

# 실제 서비스 프론트엔드 (메인 도메인)
server {
    listen %{NGINX_LISTEN_PORT:-80}%;
    server_name %{NGINX_MAIN_DOMAIN}%;
    
    # 프론트엔드 정적 파일 서빙
    root %{NGINX_MAIN_FRONTEND_PATH}%;
    index index.html;
    
    # SPA 라우팅 지원
    location / {
        try_files $uri $uri/ /index.html;
    }
    
    # API 요청은 FastAPI로 프록시
    location /api/ {
        proxy_pass http://127.0.0.1:%{FASTAPI_PORT:-8000}%;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# 관리자 페이지 (서브도메인)
server {
    listen %{NGINX_LISTEN_PORT:-80}%;
    server_name %{NGINX_ADMIN_DOMAIN}%;
    
    # 관리자 페이지 정적 파일 서빙
    root %{NGINX_ADMIN_FRONTEND_PATH}%;
    index index.html;
    
    location / {
        try_files $uri $uri/ /index.html;
    }
    
    # API는 동일한 FastAPI로 프록시
    location /api/ {
        proxy_pass http://127.0.0.1:%{FASTAPI_PORT:-8000}%;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
